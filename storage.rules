rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ========================= HELPERS =========================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailVerifiedAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'hos098sam@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        isEmailVerifiedAdmin() ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        isAdmin() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // مالك الكورس فقط (مش أي teacher)
    function isCourseOwner(courseId) {
      return isTeacher()
        && firestore.exists(/databases/(default)/documents/courses/$(courseId))
        && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    // طالب مشترك فعلاً — نتحقق من users.enrolledCourseIds (اللي بيتحدّث من السيرفر)
    function isEnrolledStudent(courseId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && courseId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.enrolledCourseIds;
    }

    // مساعدات للتحقق من الحجم والنوع بأمان (بترجع true لو العملية delete)
    function isUploadSafe(maxBytes) {
      return request.resource == null
        || (request.resource.size <= maxBytes);
    }

    function isAllowedImageType() {
      return request.resource == null
        || request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isAllowedSubmissionType() {
      return request.resource == null
        || request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp)|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|text/plain)');
    }

    function isAllowedCourseAssetType() {
      return request.resource == null
        || request.resource.contentType.matches('(application/pdf|video/(mp4|webm)|image/(jpeg|png|webp)|application/vnd\\.ms-powerpoint|application/vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation)');
    }

    // ========================= AVATARS =========================
    match /avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
        && isUploadSafe(5 * 1024 * 1024)
        && isAllowedImageType();
    }

    // ========================= SUBMISSIONS =========================
    match /submissions/{userId}/{allFiles=**} {
      allow read: if isOwner(userId) || isTeacher() || isAdmin();
      allow write: if isOwner(userId)
        && isUploadSafe(15 * 1024 * 1024)
        && isAllowedSubmissionType();
    }

    // ========================= COURSES (assets) =========================
    match /courses/{courseId}/{allFiles=**} {
      // القراءة: أدمن/مدرس/طالب مشترك
      allow read: if isAdmin()
        || isTeacher()
        || isEnrolledStudent(courseId);

      // الكتابة: أدمن أو مالك الكورس فقط
      allow write: if (isAdmin() || isCourseOwner(courseId))
        && isUploadSafe(500 * 1024 * 1024)
        && isAllowedCourseAssetType();
    }

    // ========================= DEFAULT DENY =========================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
